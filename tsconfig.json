{
  "compilerOptions": {
    "target": "es2022",
    "types": ["jest"],  
    
    "module": "node16",
    "moduleResolution": "node16",

    "rootDir": "./src",
    "outDir": "./build",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}